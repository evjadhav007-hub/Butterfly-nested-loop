#include<iostream>
using namespace std;

int main(){
  int n=4;
  //top
  for(int i=0; i<n; i++){
       for(int j=0; j<=i; j++){
      cout<<"*";
     } 
     for(int j=0; j<2*(3-i); j++){
       if(n!=0){
        cout<<" ";
       }
     }
     for(int k=0; k<(i+1); k++){
      cout<<"*";
     }
  cout<<endl;
  }
  //bottom
  for(int i=0; i<n; i++){
        for(int j=0; j<(n-i); j++){
      cout<<"*";
    }
    for(int j=0; j<(2*i); j++){
      if(n!=0){
        cout<<" ";
      }
    }
    for(int k=0; k<(n-i); k++){
      cout<<"*";
    }
    cout<<endl;

  }
  return 0;
 
}
